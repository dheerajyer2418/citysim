# The Vercel deploy is a static site served from public/ only.
# Ignore the Python/Java project so Vercel does not try to install or build it.
requirements.txt
environment.yml
pipeline/
matsim/
scenarios/
# Anchor to root only: bare "data/" also matched public/<area>/data/, which
# excluded the lazy-loaded needs_payload.json / live_payload.json from the
# deploy (404 -> maps showed no streets). Only ignore the top-level data/.
/data/
tests/
viz/
cli.py
*.py
*.bat
*.ps1
